<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="org.aohp.agentdriver">
        <permission name="android.permission.MANAGE_AOHP_VIRTUAL_DISPLAY" />
        <permission name="android.permission.MANAGE_AOHP_ADS" />
        <permission name="android.permission.INJECT_EVENTS" />
        <!-- Required for platform-signed priv-app; otherwise system_server aborts at systemReady. -->
        <permission name="android.permission.SCHEDULE_EXACT_ALARM" />
        <!-- Enable MyAccessibilityService via Settings.Secure on boot / app start (see SystemPrivilegeBootstrap). -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.SEND_SMS" />
        <!-- Hardware still capture (sensor.camera.capture) -->
        <permission name="android.permission.CAMERA" />
        <permission name="android.permission.READ_MEDIA_IMAGES" />
    </privapp-permissions>
</permissions>
