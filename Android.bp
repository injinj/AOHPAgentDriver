package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Prebuilt AOHP agent APK: build from the Gradle AOHPAgentDriver project, then place the
// output at packages/apps/AOHPAgentDriver/AOHPAgentDriver.apk. Soong re-signs it with
// the platform key when certificate: "platform" is set.
//
// IMPORTANT: IAohpContainer AIDL must match frameworks/base/.../IAohpContainer.aidl.

prebuilt_etc {
    name: "privapp-permissions-aohp",
    src: "privapp-permissions-aohp.xml",
    sub_dir: "permissions",
    // Default install name would be the module name (no .xml); SystemConfig only loads *.xml.
    filename_from_src: true,
}

android_app_import {
    name: "AOHPAgentDriver",
    apk: "AOHPAgentDriver.apk",
    certificate: "platform",
    privileged: true,
    // Match manifest uses-library-not-required from AndroidX Window on modern builds.
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

// Link this static library when building AgentDriver from Java sources (Gradle or AOSP module).
java_library {
    name: "aohp-agentdriver-security-rpc-bridge",
    srcs: ["bridge/**/*.java"],
    sdk_version: "system_current",
}
