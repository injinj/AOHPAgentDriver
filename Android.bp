package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Prebuilt AOHP agent APK: build from ../../aohp-app/AOHPAgentDriver with Gradle, then:
//   ./gradlew :app:assembleDebug
//   cp app/build/outputs/apk/debug/RuyiClient-debug.apk packages/apps/AOHPAgentDriver/AOHPAgentDriver.apk
// Soong re-signs with the platform key when certificate: "platform" is set.
//
// IMPORTANT: IAohpContainer AIDL must match frameworks/base/.../IAohpContainer.aidl.
// If you update the framework AIDL but keep an old APK here, the priv-app will crash with
// NoSuchMethodError on Binder calls (e.g. createContainer return type mismatch).

prebuilt_etc {
    name: "privapp-permissions-aohp",
    src: "privapp-permissions-aohp.xml",
    sub_dir: "permissions",
    // Default install name would be the module name (no .xml); SystemConfig only loads *.xml.
    filename_from_src: true,
}

android_app_import {
    name: "AOHPAgentDriver",
    apk: "AOHPAgentDriver.apk",
    certificate: "platform",
    privileged: true,
    // Match manifest uses-library-not-required from androidx.window (e.g. window_extensions.mk).
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}
